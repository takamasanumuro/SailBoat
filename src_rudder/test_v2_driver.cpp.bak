#include "HBridgeDriver_v2.hpp"

// Test program for the improved HBridge driver
// This can be included in main.cpp to test the new driver

namespace TestV2Driver {
    
    void runBasicTests() {
        Serial.println("=== Testing Improved HBridge Driver V2 ===");
        
        // Configuration for single channel
        HBridgeDriverV2::Config rudder_cfg = {
            .ina_pin = 43,
            .inb_pin = 42, 
            .pwm_pin = 44,
            .max_pwm = 240
        };
        
        HBridgeDriverV2 driver(rudder_cfg);
        
        // Test initialization
        Serial.println("Testing initialization...");
        auto result = driver.init();
        if (result != HBridgeDriverV2::ErrorCode::NONE) {
            Serial.print("Init failed: ");
            Serial.println(driver.getErrorString(result));
            return;
        }
        Serial.println("✓ Initialization successful");
        
        // Test error handling - invalid PWM
        Serial.println("\nTesting error handling...");
        result = driver.setPWM(300, HBridgeDriverV2::Channel::M1); // Over limit
        if (result == HBridgeDriverV2::ErrorCode::INVALID_PWM) {
            Serial.println("✓ Invalid PWM correctly rejected");
        } else {
            Serial.println("✗ Invalid PWM should have been rejected");
        }
        
        // Test percentage control
        Serial.println("\nTesting percentage control...");
        result = driver.setPercentage(50.0f, HBridgeDriverV2::Channel::M1);
        if (result == HBridgeDriverV2::ErrorCode::NONE) {
            Serial.print("✓ Set to 50% - PWM: ");
            Serial.println(driver.getCurrentPWM(HBridgeDriverV2::Channel::M1));
        }
        
        delay(2000);
        
        result = driver.setPercentage(-75.0f, HBridgeDriverV2::Channel::M1);
        if (result == HBridgeDriverV2::ErrorCode::NONE) {
            Serial.print("✓ Set to -75% - PWM: ");
            Serial.println(driver.getCurrentPWM(HBridgeDriverV2::Channel::M1));
        }
        
        delay(2000);
        
        // Test emergency stop
        Serial.println("\nTesting emergency stop...");
        result = driver.emergencyStop();
        if (result == HBridgeDriverV2::ErrorCode::NONE) {
            Serial.print("✓ Emergency stop - PWM: ");
            Serial.println(driver.getCurrentPWM(HBridgeDriverV2::Channel::M1));
        }
        
        // Test status reporting
        Serial.println("\nDriver Status:");
        driver.printStatus();
        
        // Test self-test
        Serial.println("\nRunning self-test...");
        bool test_passed = driver.performSelfTest();
        Serial.print("Self-test result: ");
        Serial.println(test_passed ? "PASS" : "FAIL");
        
        Serial.println("\n=== Test Complete ===");
    }
    
    void runInteractiveTest() {
        Serial.println("=== Interactive HBridge Driver V2 Test ===");
        Serial.println("Commands:");
        Serial.println("  p <-100 to 100> - Set percentage");
        Serial.println("  pwm <-240 to 240> - Set PWM directly");
        Serial.println("  stop - Emergency stop");
        Serial.println("  status - Show status");
        Serial.println("  test - Run self-test");
        Serial.println("  exit - Exit interactive mode");
        
        // Configuration
        HBridgeDriverV2::Config cfg = {
            .ina_pin = 43,
            .inb_pin = 42,
            .pwm_pin = 44,
            .max_pwm = 240
        };
        
        HBridgeDriverV2 driver(cfg);
        
        if (driver.init() != HBridgeDriverV2::ErrorCode::NONE) {
            Serial.println("Failed to initialize driver!");
            return;
        }
        
        char input_buffer[32];
        int buffer_index = 0;
        
        Serial.print("> ");
        
        while (true) {
            if (Serial.available()) {
                char c = Serial.read();
                
                if (c == '\r') continue;
                
                if (c == '\n') {
                    input_buffer[buffer_index] = '\0';
                    buffer_index = 0;
                    
                    Serial.println(); // New line
                    
                    if (strlen(input_buffer) > 0) {
                        // Parse command
                        char* cmd = strtok(input_buffer, " ");
                        char* arg = strtok(NULL, " ");
                        
                        if (strcmp(cmd, "p") == 0 && arg != NULL) {
                            float percentage = atof(arg);
                            auto result = driver.setPercentage(percentage, HBridgeDriverV2::Channel::M1);
                            if (result == HBridgeDriverV2::ErrorCode::NONE) {
                                Serial.print("Set to "); Serial.print(percentage); Serial.println("%");
                            } else {
                                Serial.print("Error: "); Serial.println(driver.getErrorString(result));
                            }
                        }
                        else if (strcmp(cmd, "pwm") == 0 && arg != NULL) {
                            int16_t pwm = atoi(arg);
                            auto result = driver.setPWM(pwm, HBridgeDriverV2::Channel::M1);
                            if (result == HBridgeDriverV2::ErrorCode::NONE) {
                                Serial.print("Set PWM to "); Serial.println(pwm);
                            } else {
                                Serial.print("Error: "); Serial.println(driver.getErrorString(result));
                            }
                        }
                        else if (strcmp(cmd, "stop") == 0) {
                            driver.emergencyStop();
                            Serial.println("Emergency stop executed");
                        }
                        else if (strcmp(cmd, "status") == 0) {
                            driver.printStatus();
                        }
                        else if (strcmp(cmd, "test") == 0) {
                            bool result = driver.performSelfTest();
                            Serial.print("Self-test: "); Serial.println(result ? "PASS" : "FAIL");
                        }
                        else if (strcmp(cmd, "exit") == 0) {
                            driver.emergencyStop();
                            Serial.println("Exiting interactive mode");
                            break;
                        }
                        else {
                            Serial.println("Unknown command");
                        }
                    }
                    
                    Serial.print("> ");
                } else if (buffer_index < sizeof(input_buffer) - 1) {
                    input_buffer[buffer_index++] = c;
                    Serial.print(c); // Echo
                }
            }
            
            delay(10);
        }
    }
    
}